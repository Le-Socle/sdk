{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "component": {
    "base": {
      "background": {
        "$type": "color",
        "$value": "{role.color.bg.inverse}"
      },
      "foreground": {
        "$type": "color",
        "$value": "{role.color.text.inverse}"
      },
      "card": {
        "$type": "color",
        "$value": "{role.color.bg.inverse-raised}"
      },
      "card-foreground": {
        "$type": "color",
        "$value": "{role.color.text.inverse}"
      },
      "popover": {
        "$type": "color",
        "$value": "{role.color.bg.inverse-raised}"
      },
      "popover-foreground": {
        "$type": "color",
        "$value": "{role.color.text.inverse}"
      },
      "primary": {
        "$type": "color",
        "$value": "{role.color.action.inverse}"
      },
      "primary-foreground": {
        "$type": "color",
        "$value": "{role.color.action.inverse-text}"
      },
      "primary-hover": {
        "$type": "color",
        "$value": "{role.color.action.inverse-hover}"
      },
      "secondary": {
        "$type": "color",
        "$value": "{role.color.bg.inverse-raised}"
      },
      "secondary-foreground": {
        "$type": "color",
        "$value": "{role.color.text.inverse}"
