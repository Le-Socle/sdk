        "$value": "{role.color.text.inverse}"
      },
      "destructive": {
        "$type": "color",
        "$value": "{role.color.status.error.bg}"
      },
      "border": {
        "$type": "color",
        "$value": "{role.color.border.inverse}"
      },
      "input": {
        "$type": "color",
        "$value": "{role.color.text.inverse-dim}"
      },
      "ring": {
        "$type": "color",
        "$value": "{role.color.focus.inverse}"
