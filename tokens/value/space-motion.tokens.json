            "org.le-socle": {
              "reducedMotion": {
                "value": 0.01,
                "unit": "ms"
              }
            }
          }
        },
        "slow": {
          "$value": {
            "value": 500,
            "unit": "ms"
          },
          "$description": "Changement de vue.",
          "$extensions": {
            "org.le-socle": {
              "reducedMotion": {
                "value": 0.01,
                "unit": "ms"
              }
            }
          }
        },
        "slower": {
          "$value": {
            "value": 800,
            "unit": "ms"
          },
          "$description": "Illustrations animées, séquences.",
          "$extensions": {
            "org.le-socle": {
              "reducedMotion": {
                "value": 0.01,
                "unit": "ms"
              }
            }
          }
        }
      },
      "stagger": {
        "$type": "duration",
        "$value": {
          "value": 60,
          "unit": "ms"
        },
        "$description": "Décalage entre les éléments d'une séquence.",
        "$extensions": {
          "org.le-socle": {
            "reducedMotion": {
              "value": 0,
              "unit": "ms"
            }
