    "motion": {
      "ease": {
        "$type": "cubicBezier",
        "out": {
          "$value": [
            0.16,
            1,
            0.3,
            1
          ],
          "$description": "Entrées, apparitions."
        },
        "in": {
          "$value": [
            0.7,
            0,
            0.84,
            0
          ],
          "$description": "Sorties."
        },
        "in-out": {
          "$value": [
            0.45,
            0,
            0.55,
            1
          ],
          "$description": "Déplacements, boucles."
        }
      },
      "duration": {
        "$type": "duration",
        "micro": {
          "$value": {
            "value": 120,
            "unit": "ms"
          },
          "$description": "Changement de couleur ou de filet."
        },
        "fast": {
          "$value": {
            "value": 200,
            "unit": "ms"
          },
          "$description": "Survol, focus."
        },
        "normal": {
          "$value": {
            "value": 300,
            "unit": "ms"
          },
          "$description": "Ouverture d'un accordéon ou d'un menu.",
