{
 "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
 "palette": {
  "$type": "color",
  "neutral": {
   "50": {
    "$value": {
     "colorSpace": "srgb",
     "components": [
      0.9607843137254902,
      0.9607843137254902,
      0.9686274509803922
     ],
     "hex": "#f5f5f7"
    }
   },
   "700": {
    "$value": {
     "colorSpace": "srgb",
     "components": [
      0.27058823529411763,
      0.27058823529411763,
      0.30196078431372547
     ],
     "hex": "#45454d"
    }
   },
   "900": {
    "$value": {
     "colorSpace": "oklch",
     "components": [
      0.25,
      0.04,
      260
     ]
    }
   },
   "950": {
    "$value": {
     "colorSpace": "srgb",
     "components": [
      0.050980392156862744,
      0.050980392156862744,
      0.07058823529411765
     ],
     "hex": "#0d0d12"
    }
   }
  },
  "action": {
   "600": {
    "$value": {
     "colorSpace": "oklch",
     "components": [
      0.5,
      0.15,
      255
     ]
    }
   },
   "300": {
    "$value": {
     "colorSpace": "oklch",
     "components": [
      0.8,
      0.1,
      255
     ]
    }
   }
  },
  "ink": {
   "8": {
    "$value": {
     "colorSpace": "srgb",
     "components": [
      0,
      0,
      0
     ],
     "alpha": 0.08
    }
   }
  }
 },
 "space": {
  "$type": "dimension",
  "1": {
   "$value": {
    "value": 4,
    "unit": "px"
   }
  },
  "2": {
   "$value": {
    "value": 8,
    "unit": "px"
   }
  }
 },
 "duration": {
  "fast": {
   "$type": "duration",
   "$value": {
    "value": 200,
    "unit": "ms"
   }
  }
 },
 "ease": {
  "out": {
   "$type": "cubicBezier",
   "$value": [
    0.16,
    1,
    0.3,
    1
   ]
  }
 },
 "font": {
  "family": {
   "text": {
    "$type": "fontFamily",
    "$value": [
     "Inter Variable",
     "system-ui",
     "sans-serif"
    ]
   }
  },
  "weight": {
   "regular": {
    "$type": "fontWeight",
    "$value": 400
   }
  }
 },
 "shadow": {
  "1": {
   "$type": "shadow",
   "$value": {
    "color": "{palette.ink.8}",
    "offsetX": {
     "value": 0,
     "unit": "px"
    },
    "offsetY": {
     "value": 1,
     "unit": "px"
    },
    "blur": {
     "value": 2,
     "unit": "px"
    },
    "spread": {
     "value": 0,
     "unit": "px"
    }
   }
  }
 }
}